WorldInfo {
  info [
    "OFF TOUR savannah: dry grass, tall grass, sassafras, grazing herd."
    "A designated dirt-road loop and one autonomous Clearpath Moose."
    "The rover is trained on this tourist self-drive circuit and stays on it."
    "There is no driver aboard. Remote guests would steer the camera only."
  ]
  title "OFF TOUR savannah"
  basicTimeStep 8
  contactProperties [
    ContactProperties {
      material1 "moose wheel"
      coulombFriction [
        4
      ]
      frictionRotation 0 0
      softCFM 0.00001
      bounce 0
    }
  ]
  defaultDamping Damping {
    linear 0.2
    angular 0.05
  }
}
